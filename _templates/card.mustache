<li class="app-tile">
  <a class="app-tile-link" href="{{url}}" rel="noopener">
    <img class="app-tile-icon" src="{{icon}}" alt="" width="{{width}}" height="{{height}}">
    <span class="app-tile-name">{{name}}</span>
    <span class="app-tile-blurb">{{description}}</span>
    <span class="app-tile-action">{{action}} <span aria-hidden="true">&rarr;</span></span>
  </a>
  <a class="app-github-link" href="{{github}}" aria-label="{{name}} on GitHub" title="{{name}} on GitHub" rel="noopener">
    <svg width="20" height="20" fill="currentColor" aria-hidden="true" focusable="false"><use href="#github-icon"/></svg>
    <span>GitHub</span>
  </a>
</li>
